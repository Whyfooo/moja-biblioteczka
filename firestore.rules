rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Odczyt publiczny - wszyscy mogą przeglądać kolekcję
    match /series/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /volumes/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
